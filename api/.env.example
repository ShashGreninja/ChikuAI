# Pick ONE model source for the AI features (intake, Chiku's note, Ask Chiku).
# Everything else works without any of these.

# Local development: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# On AWS: a Bedrock model or inference profile ID you have access to (uses the instance role)
# BEDROCK_MODEL_ID=
# AWS_REGION=ap-south-1

# Phone calls ("Prefer a phone call?") through Twilio. All four are needed to switch calls on.
# PUBLIC_BASE_URL is where Twilio can reach this API: the App Runner URL, or a tunnel URL locally.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# PUBLIC_BASE_URL=https://xxxx.ap-south-1.awsapprunner.com
# CALL_DAILY_CAP=50

# Report emails through Amazon SES (a verified sender address)
# SES_SENDER=
