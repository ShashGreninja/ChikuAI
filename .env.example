# Chiku.AI environment
# Copy this file to .env (same folder) and fill in what you need. Every section is optional:
# the planner, reports and both web flows work with an empty .env.
# Restart .\dev.ps1 after editing, then check http://127.0.0.1:8000/api/health


# ---------------------------------------------------------------------------
# AI features: one-line answers, Chiku's personal note, Ask Chiku chat
# Free key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest


# ---------------------------------------------------------------------------
# Phone calls: "Prefer a phone call?" on /parents (all four are needed)
# From the Twilio console. PUBLIC_BASE_URL is where Twilio can reach the API:
# locally, the URL from `cloudflared tunnel --url http://localhost:8000` (no trailing slash).
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
# Most calls placed per day, across everyone
CALL_DAILY_CAP=50


# ---------------------------------------------------------------------------
# On AWS only (App Runner sets these in api/apprunner.yaml; leave blank locally)
# ---------------------------------------------------------------------------
# Amazon Bedrock instead of Gemini, using the service's IAM role
BEDROCK_MODEL_ID=
AWS_REGION=ap-south-1
# School bulletin emails through Amazon SES, from a verified address
SES_SENDER=


# ---------------------------------------------------------------------------
# Web app (Next.js) - only needed when the API isn't on http://127.0.0.1:8000.
# Next.js reads its own env, so set this in web/.env.local or in Amplify's console.
# ---------------------------------------------------------------------------
# API_URL=https://xxxx.ap-south-1.awsapprunner.com
