# Chiku.AI environment

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest



TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
# Most calls placed per day, across everyone
CALL_DAILY_CAP=50



# Amazon Bedrock instead of Gemini, using the service's IAM role
BEDROCK_MODEL_ID=
AWS_REGION=ap-south-1
# School bulletin emails through Amazon SES, from a verified address
SES_SENDER=


# ---------------------------------------------------------------------------
# Web app (Next.js) - only needed when the API isn't on http://127.0.0.1:8000.
# Next.js reads its own env, so set this in web/.env.local or in Amplify's console.
# ---------------------------------------------------------------------------
# API_URL=https://xxxx.ap-south-1.awsapprunner.com
